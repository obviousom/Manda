# Monorepo-root environment variables. Copy to .env (gitignored) and fill in real values.

# Microsoft Teams "Workflow" webhook URL (Power Automate "When a Teams
# webhook request is received" trigger). Used by scripts/claude/notify-teams.sh
# to post Claude Code completion notifications. Treat as a secret — never commit it.
# Quote the value — Power Automate URLs contain "&", which bash treats as a
# job-control operator when this file is sourced unquoted.
TEAMS_WEBHOOK_URL="your-teams-webhook-url-here"
